{
  "name": "incarail/football-platform",
  "description": "Inca Rail evaluation Laravel 13 API",
  "type": "project",
  "require": {
    "php": "^8.5",
    "laravel/framework": "^13.0",
    "laravel/passport": "^13.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "fakerphp/faker": "^1.23",
    "nunomaduro/collision": "^8.0",
    "mockery/mockery": "^1.6",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php artisan test",
    "format": "pint",
    "lint": "pint --test",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
